name:           ref-tf
version:        0.5.0.1
cabal-version:  >= 1.10
license:        BSD3
license-file:   LICENSE
copyright:      (c) 2006-2011 Harvard University
                (c) 2011-2026 Geoffrey Mainland
author:         Geoffrey Mainland <mainland@drexel.edu>
maintainer:     Geoffrey Mainland <mainland@drexel.edu>
stability:      alpha
homepage:       https://github.com/mainland/ref-tf
bug-reports:    https://github.com/mainland/ref-tf/issues
category:       Control
synopsis:       A type class for monads with references using type families.
description:    Contains a 'MonadRef' type class that abstracts over the
                details of manipulating references, allowing one to write code
                that can operate in either the ST monad or the IO monad.
tested-with:    GHC==8.0.2,
                GHC==8.2.2,
                GHC==8.4.4,
                GHC==8.6.5,
                GHC==8.8.4,
                GHC==8.10.7,
                GHC==9.0.2,
                GHC==9.2.8,
                GHC==9.4.8,
                GHC==9.6.7,
                GHC==9.8.4,
                GHC==9.10.3,
                GHC==9.12.4,
                GHC==9.14.1

build-type:     Simple

extra-source-files:
  README.md
  CHANGELOG.md

library
  default-language: Haskell2010
  ghc-options: -Wall

  exposed-modules:
    Control.Monad.Ref

  build-depends:
    base         >= 4.9 && < 5,
    stm          >= 2.1 && < 2.6,
    transformers >= 0.5 && < 0.7

test-suite unit
  type: exitcode-stdio-1.0
  hs-source-dirs: tests
  main-is: Main.hs
  default-language: Haskell2010
  ghc-options: -Wall

  build-depends:
    base         >= 4.9  && < 5,
    ref-tf,
    stm          >= 2.1  && < 2.6,
    tasty        >= 1.4  && < 1.6,
    tasty-hunit  >= 0.10 && < 0.11,
    transformers >= 0.5  && < 0.7

source-repository head
  type:     git
  location: https://github.com/mainland/ref-tf.git
